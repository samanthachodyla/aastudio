{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.allegoryartstudio.com" }],
      "destination": "https://allegoryartstudio.com/:path*",
      "statusCode": 301
    },
    { "source": "/index.html", "destination": "/", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/features", "destination": "/features/index.html" },
    { "source": "/plans", "destination": "/plans/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/resources", "destination": "/resources/index.html" },
    { "source": "/resources/:slug", "destination": "/resources/:slug/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
